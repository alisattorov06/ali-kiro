{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "auto"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "copy": "manual"
  },
  "debug": {
    "devtools": true,
    "timing": true,
    "turn_tokens": "verbose"
  }
}
